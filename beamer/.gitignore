# LaTeX build intermediates.  The three built PDFs ARE committed (see below);
# everything else in build/ is regenerable by ./build_deck_v1.sh.
build/*
!build/JMP_seminar_deck_v1.pdf
!build/JMP_seminar_deck_v1_25min.pdf
!build/JMP_seminar_deck_v1_rehearsal.pdf
# the plain-text renderings, for reading and reviewing the deck
!build/*_text.txt
!build/verification_v4.json
!build/slide_table_v4.json

# R6 seminar deck (docs/seminar-r6): the built PDFs, their text layers, the
# build log and the number provenance are committed; everything else is
# regenerable by `make r6`.
!build/JMP_seminar_deck_r6.pdf
!build/JMP_seminar_deck_r6_rehearsal.pdf
!build/JMP_seminar_deck_r6_text.txt
!build/JMP_seminar_deck_r6_rehearsal_text.txt
!build/JMP_seminar_deck_r6_build_log.txt
!build/r6_number_provenance.json

# V16 seminar deck (rebuilt from V15): built PDFs, text layers, build log,
# number provenance and gate results are committed.
!build/JMP_seminar_beamer_v16.pdf
!build/JMP_seminar_beamer_v16_rehearsal.pdf
!build/JMP_seminar_beamer_v16_text.txt
!build/JMP_seminar_beamer_v16_rehearsal_text.txt
!build/JMP_seminar_beamer_v16_build_log.txt
!build/v16_number_provenance.json
!build/v16_verification.json

# V17 seminar deck (style revision of V16): same set of committed outputs.
!build/JMP_seminar_beamer_v17.pdf
!build/JMP_seminar_beamer_v17_rehearsal.pdf
!build/JMP_seminar_beamer_v17_text.txt
!build/JMP_seminar_beamer_v17_rehearsal_text.txt
!build/JMP_seminar_beamer_v17_build_log.txt
!build/v17_number_provenance.json
!build/v17_verification.json

# V18 seminar deck (presentation expansion): same set of committed outputs.
!build/JMP_seminar_beamer_v18.pdf
!build/JMP_seminar_beamer_v18_rehearsal.pdf
!build/JMP_seminar_beamer_v18_text.txt
!build/JMP_seminar_beamer_v18_rehearsal_text.txt
!build/JMP_seminar_beamer_v18_build_log.txt
!build/v18_number_provenance.json
!build/v18_verification.json

# V19 seminar deck (literature and presentation refinement): same committed outputs.
!build/JMP_seminar_beamer_v19.pdf
!build/JMP_seminar_beamer_v19_rehearsal.pdf
!build/JMP_seminar_beamer_v19_text.txt
!build/JMP_seminar_beamer_v19_rehearsal_text.txt
!build/JMP_seminar_beamer_v19_build_log.txt
!build/v19_number_provenance.json
!build/v19_verification.json

# stray intermediates if anyone compiles in place
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# the per-slide table is regenerated by every build
slide_table_v1.csv
__pycache__/
