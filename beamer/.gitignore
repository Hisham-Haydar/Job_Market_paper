# LaTeX build intermediates.  The three built PDFs ARE committed (see below);
# everything else in build/ is regenerable by ./build_deck_v1.sh.
build/*
!build/JMP_seminar_deck_v1.pdf
!build/JMP_seminar_deck_v1_25min.pdf
!build/JMP_seminar_deck_v1_rehearsal.pdf
# the plain-text renderings, for reading and reviewing the deck
!build/*_text.txt

# stray intermediates if anyone compiles in place
*.aux
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# the per-slide table is regenerated by every build
slide_table_v1.csv
__pycache__/
