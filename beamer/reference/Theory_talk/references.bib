  urldate = {2026-05-28},
  abstract = {We consider a simple production model and we assume that agents have unequal production skills which can in no way be attributed to their responsibility. We study how it is possible, if at all, to compensate for differential skills by applying Rawls's idea of a collective sharing in the benefits of skills. For this purpose, we introduce an axiom of solidarity, according to which agents should all be affected in the same direction if the profile of personal skills changes. We show that particular allocation rules are characterized be combining this axiom with a requirement of non-discrimination among preferences, or with a property capturing Nozick's idea of guaranteeing a minimal benefit from one's own skill.},
  keywords = {ax:compensation,prio:second-wave,role:foundation},
