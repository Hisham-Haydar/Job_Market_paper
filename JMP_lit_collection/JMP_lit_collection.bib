@article{bargainWelfareLaborSupply2013,
  title = {Welfare, Labor Supply and Heterogeneous Preferences: Evidence for {{Europe}} and the {{US}}},
  shorttitle = {Welfare, Labor Supply and Heterogeneous Preferences},
  author = {Bargain, Olivier and Decoster, André and Dolls, Mathias and Neumann, Dirk and Peichl, Andreas and Siegloch, Sebastian},
  date = {2013-10-01},
  journaltitle = {Social Choice and Welfare},
  shortjournal = {Soc Choice Welf},
  volume = {41},
  number = {4},
  pages = {789--817},
  publisher = {Springer Berlin Heidelberg},
  issn = {1432-217X},
  doi = {10.1007/s00355-012-0707-x},
  url = {https://link.springer.com/article/10.1007/s00355-012-0707-x},
  urldate = {2025-09-01},
  abstract = {Following the report of the Stiglitz Commission, measuring and comparing well-being across countries has gained renewed interest. Yet, analyses that go beyond income and incorporate non-market dimensions of welfare most often rely on the assumption of identical preferences to avoid the difficulties related to interpersonal comparisons. In this paper, we suggest an international comparison based on individual welfare rankings that fully retain preference heterogeneity. Focusing on the consumption-leisure trade-off, we estimate discrete choice labor supply models using harmonized microdata for 11 European countries and the US. We retrieve preference heterogeneity within and across countries and analyze several welfare criteria which take into account that differences in income are partly due to differences in tastes. The resulting welfare rankings clearly depend on the normative treatment of preference heterogeneity with alternative metrics. We show that these differences can indeed be explained by estimated preference heterogeneity across countries—rather than demographic composition.},
  langid = {english},
  keywords = {Equivalent Income,Indifference Curve,Interpersonal Comparison,Preference Heterogeneity,Welfare Ranking},
  note = {\textbf{Contents}
\par
\begin{itemize}

\item \href{zotero://open-pdf/0_6NYR2PUL/1}{Abstract}
\item \href{zotero://open-pdf/0_6NYR2PUL/2}{1 Introduction}
\item \href{zotero://open-pdf/0_6NYR2PUL/3}{2 Related literature}
\item \href{zotero://open-pdf/0_6NYR2PUL/5}{3 Theoretical framework}
\item \href{zotero://open-pdf/0_6NYR2PUL/9}{4 Empirical approach}
\item \href{zotero://open-pdf/0_6NYR2PUL/14}{5 Results}

\begin{itemize}

\item \href{zotero://open-pdf/0_6NYR2PUL/15}{5.1 Estimated preference heterogeneity}
\item \href{zotero://open-pdf/0_6NYR2PUL/15}{5.2 Cross-country welfare rankings}
