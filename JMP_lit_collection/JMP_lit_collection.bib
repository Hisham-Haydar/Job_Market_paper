@article{fleurbaeyOptimalIncomeTaxation2018,
  title = {Optimal {{Income Taxation Theory}} and {{Principles}} of {{Fairness}}},
  author = {Fleurbaey, Marc and Maniquet, François},
  date = {2018-09-01},
