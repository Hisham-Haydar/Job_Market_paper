\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces The estimated model against two re-estimated common-opportunity benchmarks, on the same 1,540 single-adult households, the same sampled alternatives and the same criterion. A better maximized criterion does not by itself establish that a mechanism has been identified; the margin-by-margin comparison in the fit table and figure is the substantive evidence.}}{20}{table.11}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}Money-metric well-being}{20}{subsection.5.3}\protected@file@percent }
